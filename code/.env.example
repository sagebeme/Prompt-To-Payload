# Copy this file to .env (in this code/ folder) and fill in your own values.
# .env is ignored by Git. Never commit it, and never paste a real key into code.
#
# The scripts read these from the environment; they do not load .env on their own.
# Load it into your shell first (macOS/Linux):  set -a; source .env; set +a

# Required for every script. Get one at https://platform.claude.com
ANTHROPIC_API_KEY=your-key-here

# Optional. Which inbox file the Day 11 and Day 14 agents read (default: inbox.json).
# Day 13 and Day 14 use the poisoned one.
# INBOX_FILE=inbox_poisoned.json
